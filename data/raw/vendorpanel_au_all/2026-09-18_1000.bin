<guid isPermaLink="false">6d8c1a8dd97c4b58ad6f23dd2b50afe2</guid>
<pubDate>Tue, 25 Aug 2026 23:04:00 GMT</pubDate>
<category>Plant &amp; Equipment - Purchase</category>
</item>
