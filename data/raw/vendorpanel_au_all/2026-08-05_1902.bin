<guid isPermaLink="false">935a5cc888764bec98e66659582a3969</guid>
<pubDate>Wed, 05 Aug 2026 04:57:00 GMT</pubDate>
<category>Construction &amp; Operation</category>
<category>Gas Energy, Infrastructure, Equipment</category>
<category>Utilities</category>
<category>Water &amp; Sewage</category>
</item>
